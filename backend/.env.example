# Backend environment overrides. Copy to .env (gitignored) and fill in.
#
# Everything in config.toml can also be set here, as
# DERPIGAME_<SECTION>__<FIELD> — note the *double* underscore before the field.
# The environment wins over config.toml, so this file is for secrets and
# per-deployment values rather than tuning.

# Derpibooru API key. Optional: anonymous search works, but a key raises the
# rate limit and is required for anything account-scoped. Never put this in
# config.toml — that file is checked in.
# DERPIGAME_DERPIBOORU__API_KEY=

# Origins allowed to reach the API and open the websocket. Defaults to ["*"],
# which is fine locally; set the real frontend origin before deploying.
# DERPIGAME_SERVER__CORS_ORIGINS=["https://shikogo.github.io"]

# Example of overriding a tuning value without editing config.toml:
# DERPIGAME_ROOM_DEFAULTS__TURN_SECONDS=90
